{
  "$defs": {
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "cell": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        },
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "pdf_text",
            "plain_text",
            "abstract"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Label"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
        },
        "text_unit_id": {
          "title": "Text Unit Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text_unit_id",
        "char_start",
        "char_end"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_refs": {
      "items": {
        "type": "string"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "edition_id": {
      "title": "Edition Id",
      "type": "string"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "excerpt": {
      "minLength": 1,
      "title": "Excerpt",
      "type": "string"
    },
    "excerpt_hash": {
      "title": "Excerpt Hash",
      "type": "string"
    },
    "extraction_id": {
      "title": "Extraction Id",
      "type": "string"
    },
    "fabric_id": {
      "title": "Fabric Id",
      "type": "string"
    },
    "grounding": {
      "additionalProperties": true,
      "title": "Grounding",
      "type": "object"
    },
    "locator": {
      "$ref": "#/$defs/Locator"
    },
    "retrieval_event_id": {
      "title": "Retrieval Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "full_text",
        "abstract",
        "user_text"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "text_hash": {
      "title": "Text Hash",
      "type": "string"
    }
  },
  "required": [
    "fabric_id",
    "edition_id",
    "document_id",
    "extraction_id",
    "retrieval_event_id",
    "source_hash",
    "text_hash",
    "locator",
    "excerpt",
    "excerpt_hash",
    "source_kind",
    "grounding"
  ],
  "title": "EvidenceObject",
  "type": "object"
}
