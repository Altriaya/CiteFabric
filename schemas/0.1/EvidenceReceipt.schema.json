        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "coverage": {
          "additionalProperties": true,
          "title": "Coverage",
          "type": "object"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "edition_id": {
          "title": "Edition Id",
          "type": "string"
        },
        "evidence_relations": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Evidence Relations",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "subclaims": {
          "items": {
            "additionalProperties": true,
