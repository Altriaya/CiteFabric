          "type": "string"
        },
        "verifier": {
          "additionalProperties": true,
          "title": "Verifier",
          "type": "object"
        }
      },
      "required": [
        "claim_id",
        "edition_id",
        "verdict",
        "reason_code",
        "rationale",
        "limitations",
        "coverage",
        "verifier"
